# Local-only SQLite workbench. Keep the service bound to 127.0.0.1.
DATABASE_URL=sqlite:///./xhs_workflow.db
EXPORT_DIR=./exports
UPLOAD_ROOT=./uploads
WORKER_ENABLED=true
WORKER_POLL_SECONDS=0.5
STALE_WORKER_SECONDS=300

# Safe deterministic defaults. These modes do not call paid providers.
LLM_PROVIDER=mock
IMAGE_PROVIDER=mock

# Optional real-model settings. Configure only for the explicit manual
# `real-soft --allow-paid-providers` evaluation or intentional local runs.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

CATHOVEN_COVER_REFERENCE_DIR=./references/covers
CATHOVEN_PRODUCT_REFERENCE_DIR=./references/product

# Optional bearer token for a single local operator. Leave blank by default.
API_TOKEN=
